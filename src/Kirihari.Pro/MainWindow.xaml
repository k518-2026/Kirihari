<Window x:Class="Kirihari.Pro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Kirihari.Controls;assembly=Kirihari.Core"
        Title="Kirihari Pro　動画の連結とカット（細かく調整）"
        Width="1500" Height="840" MinWidth="1200" MinHeight="680"
        Icon="pack://application:,,,/Kirihari_Pro;component/app.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource DimText}">
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionText}">
            <Setter Property="Margin" Value="0,14,0,2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上：ツールバー -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="↶ 元に戻す" Command="{Binding UndoCommand}" Margin="0,0,6,0" ToolTip="Ctrl+Z" />
                    <Button Content="↷ やり直す" Command="{Binding RedoCommand}" ToolTip="Ctrl+Y" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding AddFilesCommand}" Content="＋ 動画を追加"
                            ToolTip="Ctrl+O　（ウィンドウにドロップ、フォルダーのドロップも可）" />
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource DimText}"
                               Text="ショートカット：Space 再生　S 分割　I/O 開始/終了点　X 範囲削除　Del 区間削除　←→ 1コマ　Shift+←→ 10コマ　Ctrl+←→ 前後の区間　Ctrl+ホイール 拡大" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#FF5A3B1E" Padding="14,8"
                Visibility="{Binding FfmpegMissing, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="ffmpeg.exe を選ぶ…" Command="{Binding ChooseFfmpegCommand}" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"
                           Text="ffmpeg が見つかりません。ffmpeg.exe と ffprobe.exe をこのアプリと同じフォルダーに置くか、右のボタンで場所を指定してください。" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="10,10,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- 左：区間の一覧 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="区間の一覧（上から順につなぐ）" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                    <Button Content="▲ 前へ" Command="{Binding MoveUpCommand}" Margin="0,0,3,3" />
                    <Button Content="▼ 後ろへ" Command="{Binding MoveDownCommand}" Margin="3,0,0,3" />
                    <Button Content="✕ 区間削除" Command="{Binding DeleteSegmentCommand}" Margin="0,0,3,0" Padding="4,6"
                            Style="{StaticResource DangerButton}" ToolTip="Delete キー" />
                    <Button Content="全部消す" Command="{Binding ClearAllCommand}" Margin="3,0,0,0" />
                </UniformGrid>
                <ListBox ItemsSource="{Binding Project.Segments}" SelectedItem="{Binding SelectedSegment, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding ColorBrush}" />
                                <StackPanel Grid.Column="1" Margin="9,5,6,5">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource DimText}" />
                                    <TextBlock Text="{Binding Source.Summary}" Style="{StaticResource DimText}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 中央：プレビュー -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Black" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" MinHeight="200">
                    <Grid>
                        <MediaElement x:Name="Media" Stretch="Uniform" />
                        <Image x:Name="Frame" Stretch="Uniform" Visibility="Collapsed" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="動画ファイル（またはフォルダー）をここにドロップ" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="AVCHD の STREAM フォルダーごと入れても、中の MTS を順に読み込みます" Style="{StaticResource DimText}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1" Margin="0,8,0,4">
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="⏮" Command="{Binding GoStartCommand}" ToolTip="先頭（Home）" />
                        <Button Content="◀◀ 10" Command="{Binding StepCommand}" CommandParameter="-10" Margin="3,0,0,0" ToolTip="10コマ戻る（Shift+←）" />
                        <Button Content="◀ 1" Command="{Binding StepCommand}" CommandParameter="-1" Margin="3,0,0,0" ToolTip="1コマ戻る（←）" />
                        <Button Content="{Binding PlayText}" Command="{Binding TogglePlayCommand}" Style="{StaticResource AccentButton}"
                                Margin="3,0,0,0" MinWidth="104" ToolTip="Space" />
                        <Button Content="1 ▶" Command="{Binding StepCommand}" CommandParameter="1" Margin="3,0,0,0" ToolTip="1コマ進む（→）" />
                        <Button Content="10 ▶▶" Command="{Binding StepCommand}" CommandParameter="10" Margin="3,0,0,0" ToolTip="10コマ進む（Shift+→）" />
                        <Button Content="⏭" Command="{Binding GoEndCommand}" Margin="3,0,0,0" ToolTip="最後（End）" />
                        <Button Content="−1秒" Command="{Binding JumpSecondsCommand}" CommandParameter="-1" Margin="10,0,0,0" />
                        <Button Content="+1秒" Command="{Binding JumpSecondsCommand}" CommandParameter="1" Margin="3,0,0,0" />
                        <Button Content="−5秒" Command="{Binding JumpSecondsCommand}" CommandParameter="-5" Margin="3,0,0,0" />
                        <Button Content="+5秒" Command="{Binding JumpSecondsCommand}" CommandParameter="5" Margin="3,0,0,0" />
                    </WrapPanel>
                </DockPanel>

                <DockPanel Grid.Row="2" Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="17" Margin="14,0,0,0">
                        <Run Text="{Binding PositionText, Mode=OneWay}" />
                        <Run Text=" / " Foreground="{StaticResource TextDimBrush}" />
                        <Run Text="{Binding TotalText, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" />
                    </TextBlock>
                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="再生速度" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                        <Slider Minimum="0.25" Maximum="2" Width="110" Margin="8,0,0,0" VerticalAlignment="Center"
                                Value="{Binding PlaybackSpeed}" TickFrequency="0.25" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding SpeedText}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="36" />
                        <Button Content="1倍" Command="{Binding ResetSpeedCommand}" Margin="4,0,0,0" Padding="8,2" MinWidth="0" />
                        <CheckBox IsChecked="{Binding Muted}" Margin="16,0,0,0">
                            <TextBlock Text="消音" />
                        </CheckBox>
                        <Button Content="全体表示" Command="{Binding ZoomAllCommand}" Margin="14,0,0,0" Padding="8,2" />
                    </WrapPanel>
                </DockPanel>

                <c:TimelineControl x:Name="Timeline" Grid.Row="3" Height="74"
                                   Project="{Binding Project}" Position="{Binding Position, Mode=TwoWay}"
                                   MarkIn="{Binding MarkIn, Mode=OneWay}" MarkOut="{Binding MarkOut, Mode=OneWay}" />
            </Grid>

            <!-- 右：切る・調整・書き出し設定 -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="切る" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                    <UniformGrid Columns="2">
                        <Button Content="✂ 分割 [S]" Command="{Binding SplitCommand}" Margin="0,0,3,3" />
                        <Button Content="区間を削除 [Del]" Command="{Binding DeleteSegmentCommand}" Margin="3,0,0,3" Padding="4,6" Style="{StaticResource DangerButton}" />
                        <Button Content="前を全部削除" Command="{Binding TrimBeforeCommand}" Margin="0,0,3,3" ToolTip="再生位置より前をすべて削除" />
                        <Button Content="後ろを全部削除" Command="{Binding TrimAfterCommand}" Margin="3,0,0,3" ToolTip="再生位置より後ろをすべて削除" />
                        <Button Content="開始点 [I]" Command="{Binding SetInCommand}" Margin="0,0,3,3" />
                        <Button Content="終了点 [O]" Command="{Binding SetOutCommand}" Margin="3,0,0,3" />
                        <Button Content="範囲を削除 [X]" Command="{Binding RemoveRangeCommand}" Margin="0,0,3,0" Style="{StaticResource DangerButton}" />
                        <Button Content="範囲だけ残す" Command="{Binding KeepRangeCommand}" Margin="3,0,0,0" />
                    </UniformGrid>
                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource DimText}" Margin="0,6,0,0" />
                    <Button Content="開始点・終了点をやめる" Command="{Binding ClearMarksCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />

                    <TextBlock Text="時刻を入力して移動" Style="{StaticResource PanelTitle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="移動" Command="{Binding GoToTimeCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding TimeInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="例：1:23:45.678　23:45　125.5（秒）" />
                    </DockPanel>

                    <TextBlock Text="いまの区間（数字で直す）" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="{Binding SegInfoText}" Style="{StaticResource DimText}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="開始 " VerticalAlignment="Center" Style="{StaticResource DimText}" />
                        <TextBox Grid.Column="1" Text="{Binding SegStartInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Text="終了 " VerticalAlignment="Center" Style="{StaticResource DimText}" Margin="0,5,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SegEndInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" />
                    </Grid>
                    <Button Content="この範囲にする" Command="{Binding ApplySegmentRangeCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />

                    <TextBlock Text="書き出しの方法" Style="{StaticResource PanelTitle}" />
                    <RadioButton IsChecked="{Binding ModeCopy}"><TextBlock Text="再エンコードなし（速い・無劣化）" /></RadioButton>
                    <RadioButton IsChecked="{Binding ModeEncode}"><TextBlock Text="再エンコードする（コマ単位で正確）" /></RadioButton>
                    <TextBlock Text="{Binding CompatText}" Style="{StaticResource DimText}" Margin="0,4,0,0" />

                    <TextBlock Text="再エンコードの設定" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="エンコーダー" Style="{StaticResource FieldLabel}" Margin="0,2,0,3" />
                    <ComboBox x:Name="EncoderBox" SelectedIndex="{Binding Options.EncoderIndex}" />
                    <TextBlock Text="{Binding GpuText}" Style="{StaticResource DimText}" Margin="0,3,0,0" />

                    <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="画質　" /><Run Text="{Binding Options.QualityText, Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="12" Maximum="30" Value="{Binding Options.Quality}" TickFrequency="1" IsSnapToTickEnabled="True" />
                    <TextBlock Text="数字が小さいほどきれいで、ファイルが大きくなります。YouTube 用は 18〜20 が目安です。"
                               Style="{StaticResource DimText}" />

                    <TextBlock Text="CPU の速さ（x264 のとき）" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="PresetBox" SelectedIndex="{Binding Options.PresetIndex}" />

                    <TextBlock Text="画面の高さ" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="HeightBox" SelectedIndex="{Binding Options.HeightIndex}" />

                    <TextBlock Text="フレームレート" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="FpsBox" SelectedIndex="{Binding Options.FpsIndex}" />

                    <TextBlock Text="インターレース" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="DeintBox" SelectedIndex="{Binding Options.DeinterlaceIndex}" />

                    <TextBlock Text="音声の音質" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="AudioBox" SelectedIndex="{Binding Options.AudioIndex}" />

                    <TextBlock Text="画面の高さ・フレームレートを変える、またはインターレースを「常に解除」にすると、自動で再エンコードになります。"
                               Style="{StaticResource DimText}" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 下：書き出し -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding ExportCommand}"
                            Content="MP4で書き出す…" FontSize="15" Margin="12,0,0,0" ToolTip="Ctrl+E"
                            Visibility="{Binding ExportIdle, Converter={StaticResource BoolToVis}}" />
                    <Button DockPanel.Dock="Right" Command="{Binding CancelExportCommand}" Content="中止" Margin="12,0,0,0"
                            Style="{StaticResource DangerButton}"
                            Visibility="{Binding ExportBusy, Converter={StaticResource BoolToVis}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding EstimateText}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Margin="0,8,0,0" Visibility="{Binding ExportBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExportPercent, Mode=OneWay}" />
                    <TextBlock Text="{Binding ExportText}" Margin="0,4,0,0" />
                </StackPanel>

                <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="5" Background="#FF1F3A33"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="フォルダーを開く" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0" />
                            <Button Content="▶ 再生" Command="{Binding PlayResultCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
