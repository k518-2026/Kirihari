<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Kirihari.Lite</RootNamespace>
    <AssemblyName>Kirihari_Lite</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Product>Kirihari Lite</Product>
    <Description>動画の連結とカット（かんたん版）</Description>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <ProjectReference Include="..\Kirihari.Core\Kirihari.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ffmpeg.exe / ffprobe.exe を tools\ に置くと、実行ファイルの隣へコピーされる -->
    <None Update="tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
